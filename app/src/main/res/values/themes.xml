<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme for the classic View screen (DriverSignupActivity). A plain
         framework theme, NOT a Compose or AppCompat one. Only the visuals are
         aligned with the Compose palette (see colors.xml). -->
    <style name="Theme.Sandbox.DriverSignup" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sandbox_background</item>
        <item name="android:textColorPrimary">@color/sandbox_on_background</item>
        <item name="android:textColorHint">@color/sandbox_text_secondary</item>
        <item name="android:colorAccent">@color/sandbox_lime</item>
        <item name="android:colorControlActivated">@color/sandbox_lime</item>
        <item name="android:colorControlNormal">@color/sandbox_text_secondary</item>
    </style>
</resources>
