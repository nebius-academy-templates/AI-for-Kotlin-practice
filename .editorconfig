# Root editorconfig: editors + ktlint read this file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
# 140 instead of ktlint_official's 120: the codebase is comment-heavy by design
# (teaching material), 120 would force mass rewrapping of prose comments.
max_line_length = 140
# PascalCase @Composable functions are idiomatic Compose; do not flag them.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json}]
indent_size = 2

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
